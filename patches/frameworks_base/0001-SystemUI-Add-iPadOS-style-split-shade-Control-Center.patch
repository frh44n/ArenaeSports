diff --git a/packages/SystemUI/src/com/android/systemui/qs/IPadControlCenterController.java b/packages/SystemUI/src/com/android/systemui/qs/IPadControlCenterController.java
new file mode 100644
index 0000000..3000000
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/qs/IPadControlCenterController.java
@@ -0,0 +1,95 @@
+package com.android.systemui.qs;
+
+import android.content.Context;
+import android.graphics.RenderEffect;
+import android.graphics.Shader;
+import android.view.LayoutInflater;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import com.android.systemui.R;
+
+/**
+ * Controller for the iPadOS-style Split Control Center on Xiaomi Pad 6.
+ */
+public class IPadControlCenterController {
+    private final Context mContext;
+    private final ViewGroup mRootView;
+    private View mControlCenterView;
+    private boolean mIsOpen = false;
+    private float mStartY;
+    private static final float BLUR_RADIUS_MAX = 50.0f;
+    public static final float SPLIT_THRESHOLD_RIGHT_RATIO = 0.75f;
+
+    public IPadControlCenterController(Context context, ViewGroup rootView) {
+        mContext = context;
+        mRootView = rootView;
+        initView();
+    }
+
+    private void initView() {
+        LayoutInflater inflater = LayoutInflater.from(mContext);
+        mControlCenterView = inflater.inflate(R.layout.ipados_control_center, mRootView, false);
+        mControlCenterView.setVisibility(View.GONE);
+        mRootView.addView(mControlCenterView);
+    }
+
+    public boolean handleInterceptTouch(MotionEvent event) {
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                mStartY = event.getRawY();
+                return true;
+            case MotionEvent.ACTION_MOVE:
+                if (Math.abs(event.getRawY() - mStartY) > 20) {
+                    return true;
+                }
+                break;
+        }
+        return false;
+    }
+
+    public boolean handleTouchEvent(MotionEvent event) {
+        float y = event.getRawY();
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_MOVE:
+                float delta = Math.max(0, y - mStartY);
+                float fraction = Math.min(1.0f, delta / 600f);
+                applyExpansion(fraction);
+                return true;
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_CANCEL:
+                if (y - mStartY > 200) {
+                    openControlCenter();
+                } else {
+                    closeControlCenter();
+                }
+                return true;
+        }
+        return false;
+    }
+
+    public void openControlCenter() {
+        mIsOpen = true;
+        mControlCenterView.setVisibility(View.VISIBLE);
+        mControlCenterView.animate().alpha(1.0f).translationY(0).setDuration(250).start();
+        applyHardwareBlur(BLUR_RADIUS_MAX);
+    }
+
+    public void closeControlCenter() {
+        mIsOpen = false;
+        mControlCenterView.animate().alpha(0.0f).translationY(-100f).setDuration(200)
+                .withEndAction(() -> mControlCenterView.setVisibility(View.GONE)).start();
+        applyHardwareBlur(0f);
+    }
+
+    private void applyExpansion(float fraction) {
+        mControlCenterView.setVisibility(View.VISIBLE);
+        mControlCenterView.setAlpha(fraction);
+        applyHardwareBlur(fraction * BLUR_RADIUS_MAX);
+    }
+
+    private void applyHardwareBlur(float radius) {
+        if (radius > 1.0f) {
+            mRootView.setRenderEffect(RenderEffect.createBlurEffect(radius, radius, Shader.TileMode.CLAMP));
+        } else {
+            mRootView.setRenderEffect(null);
+        }
+    }
+}
diff --git a/packages/SystemUI/src/com/android/systemui/qs/tileimpl/IPadSliderView.java b/packages/SystemUI/src/com/android/systemui/qs/tileimpl/IPadSliderView.java
