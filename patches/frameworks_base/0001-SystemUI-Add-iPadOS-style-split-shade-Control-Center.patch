+++ b/packages/SystemUI/src/com/android/systemui/qs/tileimpl/IPadSliderView.java
@@ -0,0 +1,84 @@
+package com.android.systemui.qs.tileimpl;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.util.AttributeSet;
+import android.view.MotionEvent;
+import android.view.View;
+
+/**
+ * Custom vertical rounded slider mimicking the iPadOS brightness & volume slider.
+ */
+public class IPadSliderView extends View {
+    private float mProgress = 0.5f; // 0.0 to 1.0
+    private final Paint mBgPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mFillPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF mRect = new RectF();
+    private final RectF mFillRect = new RectF();
+    private OnSliderChangeListener mListener;
+
+    public interface OnSliderChangeListener {
+        void onProgressChanged(float progress);
+    }
+
+    public IPadSliderView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        init();
+    }
+
+    private void init() {
+        mBgPaint.setColor(0x33FFFFFF); // 20% white liquid glass
+        mFillPaint.setColor(0xE6FFFFFF); // 90% white fill
+    }
+
+    public void setProgress(float progress) {
+        mProgress = Math.max(0.0f, Math.min(1.0f, progress));
+        invalidate();
+    }
+
+    public void setOnSliderChangeListener(OnSliderChangeListener listener) {
+        mListener = listener;
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        float w = getWidth();
+        float h = getHeight();
+        float radius = w / 2.0f;
+
+        mRect.set(0, 0, w, h);
+        canvas.drawRoundRect(mRect, radius, radius, mBgPaint);
+
+        float fillTop = h * (1.0f - mProgress);
+        mFillRect.set(0, fillTop, w, h);
+        canvas.save();
+        canvas.clipRect(mRect);
+        canvas.drawRoundRect(mRect, radius, radius, mBgPaint);
+        canvas.drawRect(mFillRect, mFillPaint);
+        canvas.restore();
+    }
+
+    @Override
+    public boolean onTouchEvent(MotionEvent event) {
+        switch (event.getAction()) {
+            case MotionEvent.ACTION_DOWN:
+            case MotionEvent.ACTION_MOVE:
+                float y = event.getY();
+                float h = getHeight();
+                mProgress = Math.max(0.0f, Math.min(1.0f, 1.0f - (y / h)));
+                if (mListener != null) {
+                    mListener.onProgressChanged(mProgress);
+                }
+                invalidate();
+                return true;
+        }
+        return super.onTouchEvent(event);
+    }
+}
