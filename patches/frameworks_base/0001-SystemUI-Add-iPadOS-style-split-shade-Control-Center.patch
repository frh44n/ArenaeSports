+<?xml version="1.0" encoding="utf-8"?>
+<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/ipados_control_center_container"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@drawable/liquid_glass_full_scrim">
+
+    <!-- Floating Top-Right Modular Card Container -->
+    <LinearLayout
+        android:layout_width="440dp"
+        android:layout_height="wrap_content"
+        android:layout_gravity="top|end"
+        android:layout_marginTop="32dp"
+        android:layout_marginEnd="32dp"
+        android:orientation="vertical"
+        android:padding="20dp"
+        android:background="@drawable/liquid_glass_panel_bg"
+        android:elevation="16dp">
+
+        <!-- Upper Grid: Connectivity (2x2) and Media (2x2) -->
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="180dp"
+            android:orientation="horizontal"
+            android:weightSum="2">
+
+            <!-- 2x2 Connectivity Card -->
+            <GridLayout
+                android:layout_width="0dp"
+                android:layout_height="match_parent"
+                android:layout_weight="1"
+                android:layout_marginEnd="10dp"
+                android:columnCount="2"
+                android:rowCount="2"
+                android:padding="12dp"
+                android:background="@drawable/liquid_glass_card_bg">
+
+                <ImageView
+                    android:id="@+id/btn_wifi"
+                    android:layout_width="56dp"
+                    android:layout_height="56dp"
+                    android:background="@drawable/liquid_glass_circle_tile"
+                    android:src="@drawable/ic_wifi"
+                    android:contentDescription="Wi-Fi" />
+
+                <ImageView
+                    android:id="@+id/btn_bluetooth"
+                    android:layout_width="56dp"
+                    android:layout_height="56dp"
+                    android:layout_marginStart="12dp"
+                    android:background="@drawable/liquid_glass_circle_tile"
+                    android:src="@drawable/ic_bluetooth"
+                    android:contentDescription="Bluetooth" />
+
+                <ImageView
+                    android:id="@+id/btn_airplane"
+                    android:layout_width="56dp"
+                    android:layout_height="56dp"
+                    android:layout_marginTop="12dp"
+                    android:background="@drawable/liquid_glass_circle_tile"
+                    android:src="@drawable/ic_airplanemode_active"
+                    android:contentDescription="Airplane Mode" />
+
+                <ImageView
+                    android:id="@+id/btn_cellular"
+                    android:layout_width="56dp"
+                    android:layout_height="56dp"
+                    android:layout_marginStart="12dp"
+                    android:layout_marginTop="12dp"
+                    android:background="@drawable/liquid_glass_circle_tile"
+                    android:src="@drawable/ic_signal_cellular"
+                    android:contentDescription="Cellular" />
+            </GridLayout>
+
+            <!-- 2x2 Media Player Card -->
+            <FrameLayout
+                android:layout_width="0dp"
+                android:layout_height="match_parent"
+                android:layout_weight="1"
+                android:layout_marginStart="10dp"
+                android:padding="16dp"
+                android:background="@drawable/liquid_glass_card_bg">
+                <TextView
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:text="Now Playing"
+                    android:textColor="#FFFFFF"
+                    android:textSize="14sp"
+                    android:textStyle="bold" />
+            </FrameLayout>
+        </LinearLayout>
+
+        <!-- Sliders & Action Row -->
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="180dp"
+            android:layout_marginTop="20dp"
+            android:orientation="horizontal">
+
+            <!-- Brightness Slider -->
+            <com.android.systemui.qs.tileimpl.IPadSliderView
+                android:id="@+id/slider_brightness"
+                android:layout_width="72dp"
+                android:layout_height="match_parent"
+                android:layout_marginEnd="16dp" />
+
+            <!-- Volume Slider -->
+            <com.android.systemui.qs.tileimpl.IPadSliderView
+                android:id="@+id/slider_volume"
+                android:layout_width="72dp"
+                android:layout_height="match_parent"
+                android:layout_marginEnd="16dp" />
+
+            <!-- Quick Actions (Rotation Lock, DND, Flashlight, Camera) -->
+            <GridLayout
+                android:layout_width="match_parent"
+                android:layout_height="match_parent"
+                android:columnCount="2"
+                android:rowCount="2">
+                <ImageView
+                    android:id="@+id/btn_rotation"
+                    android:layout_width="64dp"
+                    android:layout_height="64dp"
+                    android:background="@drawable/liquid_glass_tile_bg"
+                    android:src="@drawable/ic_screen_rotation"
+                    android:contentDescription="Rotation Lock" />
+            </GridLayout>
+        </LinearLayout>
+    </LinearLayout>
+</FrameLayout>
