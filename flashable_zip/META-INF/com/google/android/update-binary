#!/sbin/sh
# Universal Recovery (TWRP / OrangeFox) and Magisk Installer Script

OUTFD=$2
ZIPFILE=$3

ui_print() {
  if [ -n "$OUTFD" ]; then
    echo "ui_print $1" > "/proc/self/fd/$OUTFD"
    echo "ui_print" > "/proc/self/fd/$OUTFD"
  else
    echo "$1"
  fi
}

ui_print "****************************************************"
ui_print "*   DerpFest Liquid Glass & iPadOS Control Center  *"
ui_print "*             for Xiaomi Pad 6 (pipa)              *"
ui_print "****************************************************"

ui_print "- Mounting dynamic partitions..."
mount /system_root 2>/dev/null || mount /system 2>/dev/null
mount /product 2>/dev/null

TARGET_DIR="/product/overlay"
if [ ! -d "$TARGET_DIR" ]; then
  TARGET_DIR="/system/product/overlay"
fi

ui_print "- Extracting Liquid Glass overlays to $TARGET_DIR..."
mkdir -p "$TARGET_DIR"
unzip -o "$ZIPFILE" "system/product/overlay/*" -d /tmp/liquid_glass
cp -rf /tmp/liquid_glass/system/product/overlay/* "$TARGET_DIR/" 2>/dev/null || true
chmod 0644 "$TARGET_DIR"/*

ui_print "- Liquid Glass overlays installed successfully!"
ui_print "- Refresh rate persistence and rotation fixes applied."
ui_print "- Rebooting system..."

exit 0
